@startuml
title BerSU Ball - Logical State Model

skinparam state {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
  FontName Arial
}

[*] --> active : Initialize\nstate(Boys_sorted, Girls_sorted)

state "active: state([B | Bs], [G | Gs])" as active

active --> active : match / |B-G|≤1
active --> active : skip_boy / B<G-1
active --> active : skip_girl / B>G+1

state "F: Final States" as F {
  state "state([], _)" as empty_boys
  state "state(_, [])" as empty_girls
}

active --> empty_boys : Boys list exhausted
active --> empty_girls : Girls list exhausted

empty_boys --> [*]
empty_girls --> [*]


@enduml